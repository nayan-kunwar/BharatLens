{
  "name": "@bharatlens/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "analyze": "node --env-file=../../.env --import tsx src/cli.ts",
    "eval": "node --env-file=../../.env --import tsx src/eval/cli.ts"
  },
  "dependencies": {
    "@bharatlens/database": "workspace:*",
    "@bharatlens/shared": "workspace:*",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
