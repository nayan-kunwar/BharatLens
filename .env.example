NODE_ENV=development
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=3001
WORKER_HEALTH_PORT=3002
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:3001

DATABASE_URL=postgres://bharatlens:bharatlens@localhost:5433/bharatlens
REDIS_URL=redis://localhost:6379

# Minutes between scheduled RSS polls by the worker. 0 disables scheduling.
INGEST_POLL_MINUTES=30

# Required by the API. The admin console login password (min 8 chars).
ADMIN_PASSWORD=change-me-dev-admin
# Admin session cookie lifetime in hours.
ADMIN_SESSION_TTL_HOURS=12
# Set to true ONLY when the admin console is served over HTTPS in a real deployment.
ADMIN_COOKIE_SECURE=false

# LLM for event analysis. Unset = deterministic stub (schema-validated, never
# auto-published). Recommended: Google Gemini via its OpenAI-compatible endpoint
# (free key from Google AI Studio; check AI Studio for the current flash model).
# LLM_API_KEY=
# LLM_MODEL=gemini-2.0-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OpenAI also works: LLM_BASE_URL=https://api.openai.com/v1 with LLM_MODEL=gpt-4o-mini.
